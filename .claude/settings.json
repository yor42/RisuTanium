{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2"
  },
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\scripts\\subagent-identity.ps1\"; exit $LASTEXITCODE",
            "shell": "powershell",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\scripts\\guard-write.ps1\"; exit $LASTEXITCODE",
            "shell": "powershell",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "svelte-lsp@risutanium-lsp": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "risutanium-lsp": {
      "source": {
        "source": "directory",
        "path": "C:\\Projects\\RisuAI\\.claude\\lsp-marketplace"
      }
    }
  }
}
