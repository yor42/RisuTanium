{
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm tauribuild",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": ["deb", "rpm", "appimage", "nsis", "app", "dmg"],
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": [
          "risum", "risup", "charx", "byaf"
        ]
      },
      {
        "ext": ["png"],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["jpg", "jpeg"],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["json"],
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  },
  "productName": "RisuTanium",
  "mainBinaryName": "RisuTanium",
  "version": "0.1.0",
  "identifier": "io.github.yor42.risutanium",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1OTA0MEE3RDY3N0EyNzMKUldSem9uZldwMENRRmUrNzVsV1poS2lQV3VkV3pIdStxZHI3Q2R2bWllM0NEdFZwYXgwa1ovbVcK",
      "endpoints": ["https://github.com/yor42/RisuTanium/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["risutaniumlocal", "risuailocal"]
      }
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "RisuTanium",
        "width": 1024,
        "height": 768,
        "minWidth": 300,
        "minHeight": 500,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "assetProtocol": {
        "scope": [
          "asset",
          "$APPDATA",
          "$APPDATA/*",
          "$APPDATA/**/*"
        ],
        "enable": true
      },
      "csp": null
    }
  }
}