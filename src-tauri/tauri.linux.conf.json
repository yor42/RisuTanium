{
  "bundle": {
    "linux": {
      "deb": {"files": {"/usr/share/mime/packages/risutanium.xml": "risutanium-mime.xml"}},
      "rpm": {"files": {"/usr/share/mime/packages/risutanium.xml": "risutanium-mime.xml"}}
    },
    "fileAssociations": [
      {"ext": ["risum"], "mimeType": "application/x-risutanium-module"},
      {"ext": ["risup"], "mimeType": "application/x-risutanium-preset"},
      {"ext": ["charx"], "mimeType": "application/x-risutanium-charx"},
      {"ext": ["byaf"], "mimeType": "application/x-risutanium-byaf"},
      {
        "ext": ["png"],
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "image/png"
      },
      {
        "ext": ["jpg", "jpeg"],
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "image/jpeg"
      },
      {
        "ext": ["json"],
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/json"
      }
    ]
  }
}
