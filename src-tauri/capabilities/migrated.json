{
  "identifier": "migrated",
  "description": "permissions that were migrated from v1",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-maximize",
    "core:window:allow-set-fullscreen",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "http://*"
        },
        {
          "url": "https://*"
        },
        {
          "url": "mailto:*"
        },
        {
          "url": "tel:*"
        }
      ]
    },
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-confirm",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*/*"
        },
        {
          "url": "https://*/**/*"
        },
        {
          "url": "https://*:**"
        },
        {
          "url": "http://*/*"
        },
        {
          "url": "http://*/**/*"
        },
        {
          "url": "http://*:**"
        }
      ]
    },
    "os:allow-platform",
    "os:allow-version",
    "os:allow-os-type",
    "os:allow-family",
    "os:allow-arch",
    "os:allow-exe-extension",
    "os:allow-locale",
    "process:allow-restart",
    "os:default"
  ]
}