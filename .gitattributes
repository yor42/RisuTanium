# Keep local .gitignore changes when merging upstream.
.gitignore merge=ours
# Historical workflow snapshots retain their recorded original bytes.
Agents/Archive/2026-10-08/AGENTS.snapshot.md -text
Agents/Archive/2026-10-08/Live-State.md -text
Agents/Archive/2026-10-08/Phase2-Handoff.md -text
# The device-check scripts are LF only (PowerShell and node read them byte-exact).
Agents/Tools/device/** text eol=lf
# The chat-shell harness scripts are LF only, like the device-check scripts.
Agents/Tools/chatshell-cdp/** text eol=lf
# Vitest rewrites a snapshot file that is not byte-identical to its LF output, so keep it LF in every checkout.
*.snap text eol=lf
# pnpm applies patches byte-exact; an autocrlf checkout must not turn them into CRLF.
patches/*.patch -text
# The patched Svelte files match upstream Svelte's LF bytes in every checkout, so an upgrade diff stays clean.
patches/svelte-5.57.3/** text eol=lf
# The .rtb goldens are frozen bytes: binary files are never converted, and the refs list is LF in every checkout.
src/ts/drive/tests/rtbGoldens/*.rtb binary
src/ts/drive/tests/rtbGoldens/*.rtbseg binary
src/ts/drive/tests/rtbGoldens/*.json text eol=lf
src/ts/themePack/goldens/*.risutheme binary
src/ts/themePack/fixtures/packs/*.risutheme binary
